{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(./gradlew compileJava)",
      "Bash(./gradlew build -x test)",
      "Bash(./gradlew test)",
      "Bash(./gradlew test:*)",
      "Bash(CI=true ./gradlew clean build)",
      "Bash(gcloud logging read:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./uploads/**)",
      "Read(./db/**)",
      "Bash(git push:*)",
      "Bash(rm -rf*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services update:*)",
      "Bash(gcloud sql:*)",
      "Bash(gcloud secrets:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./gradlew compileJava -q || exit 2"
          }
        ]
      }
    ]
  }
}
